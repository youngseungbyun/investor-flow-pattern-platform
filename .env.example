# ── 필수 키 (서버 전용. NEXT_PUBLIC_ 로 노출하지 말 것) ─────────────────────────
DATA_GO_KR_API_KEY=
OPEN_DART_API_KEY=

# ── DB ────────────────────────────────────────────────────────────────────────
# 기본값은 로컬 PGlite 소켓 서버(npm run db:server).
# Supabase/원격 Postgres 로 옮기려면 이 값만 바꾸면 된다.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/postgres
PGLITE_DATA_DIR=C:/Users/speed/AppData/Local/supply-demand-dashboard/pgdata
PGLITE_PORT=55432

# ── 수급 provider 전환 (완료기준 9) ───────────────────────────────────────────
# 쉼표로 여러 개를 우선순위대로 나열한다. 앞쪽 provider 가 커버하지 못하는
# 투자자 구분만 뒤쪽 provider 가 채운다.
#   naver            : 개인·외국인·기관합계. 무료·무로그인·전종목 일별. (사모 세분 없음)
#   krx-csv          : KRX Data Marketplace 에서 내려받은 CSV 를 읽는다. 사모 세분 가능.
#   krx-marketplace  : KRX Data Marketplace 자동 로그인 수집. 사모 세분 가능. 계정 필요.
#   licensed         : 정식 계약 API. LICENSED_FLOW_API_BASE/KEY 필요.
INVESTOR_FLOW_PROVIDER=kis

# krx-csv provider 가 읽을 디렉터리
KRX_CSV_DIR=data/krx-csv

# krx-marketplace provider 용 계정. data.krx.co.kr 은 2026년 기준 로그인 필수다.
# 본인 계정을 직접 입력한다. 비워두면 이 provider 는 자동으로 비활성화된다.
KRX_MARKETPLACE_ID=
KRX_MARKETPLACE_PW=

# licensed provider 용
LICENSED_FLOW_API_BASE=
LICENSED_FLOW_API_KEY=

# ── 거래원(증권사 창구) provider ──────────────────────────────────────────────
#   none | krx-marketplace | krx-csv
MEMBER_FLOW_PROVIDER=none

# ── 수집 정책 ────────────────────────────────────────────────────────────────
# 외부 요청 최소 간격(ms). 라이선스 가드레일상 1000 미만으로 낮추지 말 것.
REQUEST_INTERVAL_MS=1000
# 초기 백필 거래일 수 (컵앤핸들 150봉 + 핸들 25봉 + 여유)
HISTORY_DAYS=260

# ── 기타 ─────────────────────────────────────────────────────────────────────
DEFAULT_USER_ID=local
# TradingView Charting Library 승인 후 정적 파일을 놓은 경로(public 기준)
NEXT_PUBLIC_TV_LIBRARY_PATH=

# ── 한국투자증권(KIS) Open API ────────────────────────────────────────────────
# 모의: https://openapivts.koreainvestment.com:29443 (초당 2건)
# 실전: https://openapi.koreainvestment.com:9443     (초당 20건)
KIS_DOMAIN=https://openapivts.koreainvestment.com:29443
KIS_APP_KEY=
KIS_APP_SECRET=
# 비우면 도메인으로 자동 판별(모의 2, 실전 15)

# ── 분봉 provider ─────────────────────────────────────────────────────────────
# kis   : 최근 세션만 (1일)
# yahoo : 과거 소급 — 1분 14일 · 5분 57일 · 1시간 700일. 인증 불필요
MINUTE_PROVIDER=kis,yahoo
KIS_RATE_PER_SEC=

# ── Supabase 전환 ─────────────────────────────────────────────────────────────
# 로컬(PGlite)은 위 DATABASE_URL 을 그대로 쓰고 DB_SCHEMA 는 비워 둔다.
# Supabase 로 붙일 때만 아래 두 줄을 채운다.
#   1) Supabase 대시보드 > Connect > Session pooler 의 URI 를 통째로 복사
#   2) [YOUR-PASSWORD] 자리에 DB 비밀번호를 넣는다
# DATABASE_URL=postgresql://postgres.ikgdcrnqumnqycoyonje:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres
# DB_SCHEMA=market
DB_SCHEMA=
